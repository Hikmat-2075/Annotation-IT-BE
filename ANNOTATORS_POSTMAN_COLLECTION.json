{
  "info": {
    "_postman_id": "annotators-api-collection",
    "name": "Annotation System - Annotators API",
    "description": "Annotators Management API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Annotators",
      "item": [
        {
          "name": "Create Annotator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/annotators",
              "host": ["{{base_url}}"],
              "path": ["annotators"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Annotators",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators",
              "host": ["{{base_url}}"],
              "path": ["annotators"]
            }
          },
          "response": []
        },
        {
          "name": "Get Annotator Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators/statistics",
              "host": ["{{base_url}}"],
              "path": ["annotators", "statistics"]
            }
          },
          "response": []
        },
        {
          "name": "Get Annotator by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators/{{annotator_id}}",
              "host": ["{{base_url}}"],
              "path": ["annotators", "{{annotator_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/annotators/profile/me",
              "host": ["{{base_url}}"],
              "path": ["annotators", "profile", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Update Annotator",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"total_annotated\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/annotators/{{annotator_id}}",
              "host": ["{{base_url}}"],
              "path": ["annotators", "{{annotator_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Add Completed Task",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators/{{annotator_id}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["annotators", "{{annotator_id}}", "tasks", "{{task_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Completed Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators/{{annotator_id}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["annotators", "{{annotator_id}}", "tasks", "{{task_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Annotator",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/annotators/{{annotator_id}}",
              "host": ["{{base_url}}"],
              "path": ["annotators", "{{annotator_id}}"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "annotator_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "task-123",
      "type": "string"
    }
  ]
}
